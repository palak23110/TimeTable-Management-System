{
  "name": "bmu-ttms-auth",
  "version": "1.0.0",
  "private": true,
  "description": "BMU TTMS authentication foundation using Express and MySQL",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:seed-admin": "node backend/database/seed-admin.js",
    "db:seed-test-accounts": "node backend/database/seed-test-accounts.js",
    "db:migrate-teachers": "node backend/database/migrate-teacher-management.js",
    "db:migrate-teacher-profile-audit": "node backend/database/migrate-teacher-profile-audit.js",
    "db:migrate-students": "node backend/database/migrate-student-management.js",
    "db:migrate-subjects": "node backend/database/migrate-subject-management.js",
    "db:migrate-rooms": "node backend/database/migrate-room-management.js",
    "db:migrate-time-slots": "node backend/database/migrate-time-slot-management.js",
    "curriculum:preview": "node backend/database/import-curriculum.js",
    "test:subjects": "node --test backend/test/subject-management.test.js",
    "test:rooms": "node --test backend/test/room-management.test.js",
    "test:time-slots": "node --test backend/test/time-slot-management.test.js",
    "test:students": "node --test backend/test/student-management.test.js",
    "test:teachers": "node --test backend/test/teacher-management.test.js",
    "test:auth-roles": "node --test backend/test/auth-roles.test.js",
    "test:tc05": "node --test backend/test/tc05-reset-flow.test.js",
    "db:migrate-timetable": "node backend/database/migrate-timetable-management.js",
    "db:migrate-rescheduling": "node backend/database/migrate-timetable-rescheduling.js",
    "test:timetable": "node --test backend/test/timetable-management.test.js",
    "test:conflicts": "node --test backend/test/conflict-detection.test.js",
    "test:viewing": "node --test backend/test/timetable-viewing.test.js",
    "test:rescheduling": "node --test backend/test/timetable-rescheduling.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.3.1"
  }
}
